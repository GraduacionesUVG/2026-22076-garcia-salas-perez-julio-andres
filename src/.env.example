# Required: Supabase project with the application schema and Auth enabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace_with_your_anon_key

# Optional AI providers. Leave empty to use local methodological heuristics.
# Conversational AI requires a configured provider and does not have a local chat substitute.
AI_GATEWAY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
DELIMITATION_CHAT_MODEL=
RESEARCH_DESIGN_REVIEW_MODEL=
SAMPLE_CONFIG_REVIEW_MODEL=

# Diagnostics are restricted by default.
INTERNAL_DIAGNOSTICS_TOKEN=
ENABLE_LOCAL_DIAGNOSTICS=false
AI_LOG_VERBOSE=false
SECURITY_LOG_VERBOSE=false
LOG_ERROR_STACKS=false
