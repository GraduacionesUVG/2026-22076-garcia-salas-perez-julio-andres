{
  "name": "antropologia-backend-graduacion",
  "version": "1.0.0",
  "private": true,
  "description": "API para investigación antropológica cualitativa; entrega de backend",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.backend.config.cjs --runInBand",
    "test:coverage": "npm test -- --coverage",
    "test:integration": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.backend-tests.local node_modules/@playwright/test/cli.js test --config=playwright.backend.config.ts --project=backend --workers=1",
    "test:api": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.backend-tests.local node_modules/@playwright/test/cli.js test --config=playwright.backend.config.ts --project=backend --workers=1",
    "test:backend:no-ai": "node scripts/backend-test-report.mjs run-no-ai",
    "test:backend:e2e": "node scripts/backend-test-report.mjs run-backend-e2e",
    "demo:api": "node scripts/demo-api.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.64",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.95.3",
    "ai": "6.0.134",
    "docx": "9.7.1",
    "jszip": "3.10.1",
    "next": "16.2.6",
    "pdf-lib": "1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "3.25.76",
    "@next/env": "16.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.33",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "jest": "30.2.0",
    "jest-environment-node": "30.2.0",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3"
  }
}
